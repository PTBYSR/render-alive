# ==============================================================================
# Render Alive — Environment Configuration Template
# Copy this file to .env.local and populate the values below
# ==============================================================================

# Upstash Redis Database (Get free credentials from https://console.upstash.com)
UPSTASH_REDIS_REST_URL="https://your-db-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Keep-Alive Cron Endpoint Security Secret
# Used to authenticate recurring ping requests from external cron (e.g. cron-job.org)
CRON_SECRET="your_custom_cron_secret_here"

# Admin Dashboard Secret (/admin)
ADMIN_SECRET="your_admin_dashboard_secret_here"

# Auth.js / NextAuth Configuration
# Run `openssl rand -base64 32` or type a random 32-character string
AUTH_SECRET="your_nextauth_secret_minimum_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Optional - for Google 1-Click Login)
# Obtain from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
